<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121217"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ מרכז שליטה נסתר"
            android:textColor="#34C759"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvAdbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFD60A"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="סיסמת כניסה למחשבון (ספרות בלבד):"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etSecretPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="לדוגמה: 123456"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="איש קשר מורשה (שם בוואטסאפ או מספר טלפון ב-SMS):"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etAllowedContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="השאר ריק כדי לאפשר לכל שולח"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:layout_marginBottom="14dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGrantPerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. אשר הרשאות (מיקום, SMS, שיחות והתראות)"
                android:background="@drawable/bg_btn_func"
                android:textColor="#5AC8FA" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="טריגרים פעילים (עובדים ב-WhatsApp וב-SMS):"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/triggersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ הוסף טריגר חדש"
            android:background="@drawable/bg_btn_op"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שמור שינויים וסגור"
            android:background="@drawable/bg_btn_eq"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
